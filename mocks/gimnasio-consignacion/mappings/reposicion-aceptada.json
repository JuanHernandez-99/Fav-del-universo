{
  "priority": 10,
  "request": {
    "method": "POST",
    "urlPath": "/api/v1/consignaciones/reposiciones",
    "headers": {
      "X-API-Key": { "matches": ".+" },
      "Idempotency-Key": { "matches": ".+" },
      "Content-Type": { "contains": "application/json" }
    },
    "bodyPatterns": [
      { "matchesJsonPath": "$[?(@.proveedorId == 'fav')]" },
      { "matchesJsonPath": "$.productoCodigo" },
      { "matchesJsonPath": "$[?(@.unidades >= 1)]" },
      { "matchesJsonPath": "$.referencia" }
    ]
  },
  "response": {
    "status": 201,
    "headers": { "Content-Type": "application/json", "Cache-Control": "no-store" },
    "jsonBody": { "reposicionId": "{{randomValue type='UUID'}}", "estado": "RECIBIDA" },
    "transformers": ["response-template"]
  }
}
