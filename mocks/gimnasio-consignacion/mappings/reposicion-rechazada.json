{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/api/v1/consignaciones/reposiciones",
    "headers": { "Idempotency-Key": { "matches": "probar-rechazo-.*" } }
  },
  "response": {
    "status": 422,
    "headers": { "Content-Type": "application/json", "Cache-Control": "no-store" },
    "jsonBody": { "codigo": "STOCK_NO_REPRESENTABLE", "mensaje": "El saldo resultante no puede representarse de forma segura." }
  }
}
