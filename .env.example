# Copiar a .env y completar. NO subir .env al repositorio.
# Todos los valores de ejemplo son [propuesta]: se confirman al implementar.
#
# En la nube (desplegar/README.md) los valores de abajo NO sirven: son públicos. Cada contraseña y clave
# se reemplaza por una propia, generada con:  openssl rand -hex 24
# (hexadecimal: la contraseña de RabbitMQ va dentro de una URL, y un + / = la rompería)

# --- Nube: solo en la VM (docker-compose.cloud.yml) ---
# Con esta línea, `docker compose ps`, `logs`, etc. usan los dos archivos sin escribir los -f.
# COMPOSE_FILE=docker-compose.yml:docker-compose.cloud.yml
# DOMINIO=fav-ucc.chilecentral.cloudapp.azure.com
# Primera prueba con certificados de prueba de Let's Encrypt; después, borrar esta línea:
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# --- MongoDB (Catálogo) ---
MONGO_INITDB_ROOT_USERNAME=catalogo
MONGO_INITDB_ROOT_PASSWORD=cambiar
MONGO_DB=catalogo
# Datos de ejemplo de Catálogo: minimo (los 2 productos del contrato) o completa (más el volumen de prueba).
# CATALOGO_RECARGAR=true vacía las colecciones y vuelve a cargar al levantar.
CATALOGO_CARGA=minimo
CATALOGO_RECARGAR=false

# --- MySQL: una instancia por servicio (RNF-08) ---
INVENTARIO_DB_ROOT_PASSWORD=cambiar
INVENTARIO_DB_NAME=inventario
INVENTARIO_DB_USER=inventario
INVENTARIO_DB_PASSWORD=cambiar

VENTAS_DB_ROOT_PASSWORD=cambiar
VENTAS_DB_NAME=ventas
VENTAS_DB_USER=ventas
VENTAS_DB_PASSWORD=cambiar

USUARIOS_DB_ROOT_PASSWORD=cambiar
USUARIOS_DB_NAME=usuarios
USUARIOS_DB_USER=usuarios
USUARIOS_DB_PASSWORD=cambiar

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=fav
RABBITMQ_DEFAULT_PASS=cambiar

# --- Token (ADR-015): las claves RS256 las genera usuarios-init, no hay que crearlas ---
JWT_EXPIRATION_MINUTES=60

# --- Cuenta de administrador (ADR-015). Definir valores propios en un entorno público ---
ADMIN_EMAIL=admin@fav.example
ADMIN_PASSWORD=cambiar-admin-local

# --- Grafana (ADR-011): el tablero se ve sin iniciar sesión; esta es la clave del usuario admin, para editar ---
GRAFANA_ADMIN_PASSWORD=cambiar

# --- Mercado Pago (Ventas): en local es el simulador (ADR-014) ---
MERCADOPAGO_ACCESS_TOKEN=token-del-simulador
MERCADOPAGO_WEBHOOK_SECRET=secreto-del-simulador

# --- Mail (Ventas): en local es Mailpit (ADR-014) ---
MAIL_FROM=ventas@fav.example
MAIL_ADMIN=admin@fav.example

# --- Datos para transferir (Ventas): [?] los define el cliente; estos son ficticios ---
TRANSFERENCIA_ALIAS=FAV.EJEMPLO.ALIAS
TRANSFERENCIA_TITULAR=FAV (ejemplo)

# --- Capacidad compartida (ADR-008): clave del grupo consumidor, validada en el gateway ---
CAPACIDAD_API_KEY=clave-grupo-proveedores
# Clave del gimnasio: ve el catálogo y la disponibilidad, sin hacer pedidos. Tiene que ser distinta de la anterior
CAPACIDAD_API_KEY_GIMNASIO=clave-grupo-gimnasio
# Con false se apagan GET /v1/productos, GET /v1/disponibilidad y POST /v1/pedidos (ADR-008)
CAPACIDAD_PUBLICA_ACTIVA=true

# --- Catálogo: búsqueda (ADR-006). Vacía, usa el texto de MongoDB; sirve donde no se despliega el motor ---
# ELASTICSEARCH_URL=

# --- Catálogo: caché (ADR-019). false: sin caché, para medir la diferencia ---
CACHE_ENABLED=true
# MEMCACHED_ADDR=memcached:11211

# --- Inventario ---
INVENTARIO_DATOS_EJEMPLO=true

# --- Gimnasio (capacidad consumida, ADR-018). Sin URL usa el mock local ---
GIMNASIO_BASE_URL=http://gimnasio-mock:8080
# La clave real la da el gimnasio por un canal privado: nunca va al repositorio
GIMNASIO_API_KEY=clave-de-fav-en-el-gimnasio
GIMNASIO_TIMEOUT_MS=3000
