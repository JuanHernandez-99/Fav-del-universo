          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n" value="&lt;b&gt;Vencimiento de la reserva:&lt;/b&gt; 20 minutos con Mercado Pago y 48 horas con transferencia (RN-08, RN-09).&lt;br&gt;&lt;b&gt;A verificar:&lt;/b&gt; la resolución es manual; cómo se resuelve (reintegro o reasignación) está pendiente con el cliente (RN-14).&lt;br&gt;&lt;b&gt;Pagada → Entregada al correo → Entregada:&lt;/b&gt; los pasos posteriores al pago los actualiza el administrador a mano (RN-19, HU-23)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#444444;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="20" y="470" width="1500" height="70" as="geometry" />
        </mxCell>
