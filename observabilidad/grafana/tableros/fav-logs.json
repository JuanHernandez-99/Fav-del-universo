{
  "uid": "fav-logs",
  "title": "FAV · Logs",
  "tags": [
    "fav"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "description": "Logs de los servicios guardados en mysql-logs (ADR-020). Pegar un track id (X-Correlation-Id de la respuesta) para seguir un pedido entre servicios.",
  "links": [
    {
      "title": "FAV · Estado general",
      "type": "link",
      "url": "/d/fav-general/fav-estado-general",
      "icon": "dashboard",
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "track_id",
        "label": "Track id",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [
          {
            "selected": true,
            "text": "",
            "value": ""
          }
        ],
        "description": "El X-Correlation-Id (o X-Track-ID) que devuelve el gateway. Vacío: las últimas líneas."
      },
      {
        "type": "custom",
        "name": "servicio",
        "label": "Servicio",
        "query": "catalogo,inventario,ventas,usuarios",
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "$__all"
          },
          {
            "selected": false,
            "text": "catalogo",
            "value": "catalogo"
          },
          {
            "selected": false,
            "text": "inventario",
            "value": "inventario"
          },
          {
            "selected": false,
            "text": "ventas",
            "value": "ventas"
          },
          {
            "selected": false,
            "text": "usuarios",
            "value": "usuarios"
          }
        ]
      },
      {
        "type": "custom",
        "name": "nivel",
        "label": "Nivel",
        "query": "info,warn,error",
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "$__all"
          },
          {
            "selected": false,
